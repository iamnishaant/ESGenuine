{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AAMLT Claim Schema (Production)",
  "description": "Structured schema for ESG claims with full provenance chain.",
  "type": "object",
  "properties": {
    "claim_id": {
      "type": "string",
      "format": "uuid"
    },
    "report_id": {
      "type": "string",
      "description": "FK to source ESG report."
    },

    "aspect": {
      "type": ["string", "null"],
      "description": "WHAT topic (emissions, water, biodiversity, deforestation).",
      "examples": ["Scope 1 emissions", "water recycling", "reforestation"]
    },
    "action": {
      "type": ["string", "null"],
      "description": "WHAT was done (reduced, increased, achieved, planted).",
      "examples": ["reduced", "increased", "achieved"]
    },
    "metric": {
      "type": ["object", "null"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string" },
        "normalized_value": { "type": ["number", "null"], "description": "Value normalized to SI units." },
        "normalized_unit": { "type": ["string", "null"] }
      },
      "required": ["value", "unit"]
    },
    "location": {
      "type": ["object", "null"],
      "properties": {
        "raw_text": { "type": "string" },
        "specificity": { "type": "string", "enum": ["facility", "city", "region", "country", "global"] },
        "lat": { "type": ["number", "null"] },
        "lon": { "type": ["number", "null"] },
        "geocode_confidence": { "type": ["number", "null"], "description": "0-1 confidence of geocoding." }
      },
      "required": ["raw_text", "specificity"]
    },
    "time": {
      "type": ["object", "null"],
      "properties": {
        "start_date": { "type": ["string", "null"], "format": "date" },
        "end_date": { "type": ["string", "null"], "format": "date" },
        "baseline_year": { "type": ["integer", "null"] }
      }
    },

    "provenance": {
      "type": "object",
      "description": "Exact source location in the original PDF. Required for UI highlighting and auditability.",
      "properties": {
        "source_sentence": { "type": "string", "description": "Verbatim sentence from the PDF." },
        "page_number": { "type": "integer" },
        "chunk_id": { "type": "string" },
        "block_id": { "type": "string" },
        "section_label": { "type": "string", "description": "ESG section the claim was found in." },
        "bbox": {
          "type": "object",
          "properties": {
            "x0": { "type": "number" },
            "y0": { "type": "number" },
            "x1": { "type": "number" },
            "y1": { "type": "number" }
          },
          "required": ["x0", "y0", "x1", "y1"]
        }
      },
      "required": ["source_sentence", "page_number", "chunk_id", "section_label", "bbox"]
    },

    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "LLM extraction confidence for this claim."
    },

    "embedding": {
      "type": "array",
      "description": "pgvector: 1024-dim vector for semantic similarity (Week 4).",
      "items": { "type": "number" },
      "maxItems": 1024
    },

    "observability_type": {
      "type": "string",
      "enum": ["optical_possible", "sar_possible", "not_observable"],
      "description": "Whether this claim can be verified via satellite. Feeds CVE."
    }
  },
  "required": ["claim_id", "report_id", "aspect", "action", "provenance", "confidence"]
}
