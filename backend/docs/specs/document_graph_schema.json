{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Document Graph Schema",
  "description": "Defines the hierarchical structure of a parsed ESG PDF for cross-reference, contradiction detection, and provenance navigation.",

  "definitions": {
    "document_node": {
      "type": "object",
      "properties": {
        "node_id": { "type": "string" },
        "node_type": { "type": "string", "enum": ["document", "section", "subsection", "paragraph", "sentence", "table", "table_row", "table_cell", "figure", "footnote"] },
        "parent_id": { "type": ["string", "null"] },
        "children_ids": { "type": "array", "items": { "type": "string" } },
        "page_number": { "type": "integer" },
        "text": { "type": ["string", "null"] },
        "bbox": {
          "type": ["object", "null"],
          "properties": {
            "x0": { "type": "number" },
            "y0": { "type": "number" },
            "x1": { "type": "number" },
            "y1": { "type": "number" }
          }
        },
        "metadata": {
          "type": "object",
          "properties": {
            "font_size": { "type": ["number", "null"] },
            "is_bold": { "type": "boolean" },
            "section_label": { "type": ["string", "null"], "description": "Mapped ESG category (Environmental Performance, Governance, etc.)" },
            "heading_level": { "type": ["integer", "null"] }
          }
        }
      },
      "required": ["node_id", "node_type", "page_number"]
    }
  },

  "type": "object",
  "properties": {
    "document_id": { "type": "string" },
    "filename": { "type": "string" },
    "total_pages": { "type": "integer" },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/definitions/document_node" }
    },
    "edges": {
      "type": "array",
      "description": "Directed edges: parent → child, claim → source_sentence, contradiction → claim pair.",
      "items": {
        "type": "object",
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" },
          "edge_type": { "type": "string", "enum": ["contains", "references", "contradicts", "supports", "duplicate_of"] }
        },
        "required": ["source", "target", "edge_type"]
      }
    }
  },
  "required": ["document_id", "nodes", "edges"]
}
