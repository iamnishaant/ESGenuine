# Pharos Integrity - Environment Variables

# Choose ONE of the following LLM API keys for Week 3 Claim Extraction

# Recommended: NVIDIA NIM (large hosted models, OpenAI-compatible)
# Get key from: https://build.nvidia.com  → preferred when set
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Alternative (Fast, Generous Free Tier)
# Get key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Alternative (Anthropic)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Alternative (OpenAI)
# OPENAI_API_KEY=your_openai_api_key_here

# If ALL are left blank, the system will use the rule-based regex fallback extractor.

# Supabase (frontend reads these via Vite; backend ingestion reads them too)
VITE_SUPABASE_URL=https://your_project_ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here
VITE_SUPABASE_PROJECT_ID=your_project_ref

# Service-role key — BACKEND ONLY, never exposed to the frontend bundle.
# It bypasses RLS, so it is required for every write path (ingest, contradictions,
# claim_reviews, satellite_evidence) once backend/database/2026-08-09_enable_rls.sql
# is applied and anon is demoted to SELECT-only. Unset = falls back to the anon key
# (fine before the migration, and for read-only deploys).
# Supabase Dashboard -> Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Direct Postgres connection for DB setup/maintenance scripts + auth user store
# (backend/database/setup_db.py, backend/scripts/populate_reports.py, backend/src/api/auth_routes.py)
DATABASE_URL=postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres

# Auth — signs JWT access/refresh tokens for the write-endpoint gate.
# REQUIRED in production (the app refuses to start without it when ENVIRONMENT=production).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_64_char_hex_secret_here
ENVIRONMENT=development   # set to "production" to enforce HTTPS-grade secrets + fail-closed JWT
