# Pharos Integrity - Environment Variables

# Choose ONE of the following LLM API keys for Week 3 Claim Extraction

# Recommended (Fastest, Generous Free Tier)
# Get key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Alternative (Anthropic)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Alternative (OpenAI)
# OPENAI_API_KEY=your_openai_api_key_here

# If ALL are left blank, the system will use the rule-based regex fallback extractor.

# Supabase (frontend reads these via Vite; backend ingestion reads them too)
VITE_SUPABASE_URL=https://your_project_ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here
VITE_SUPABASE_PROJECT_ID=your_project_ref

# Direct Postgres connection for DB setup/maintenance scripts
# (backend/database/setup_db.py, backend/scripts/populate_reports.py)
DATABASE_URL=postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres
