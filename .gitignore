# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# tsc build-mode incremental cache (CI runs `tsc -b --force`)
*.tsbuildinfo

# Secrets — never commit
.env
.env.*
!.env.example

# Python
.venv/
.venv-docling/
.venv-*/
venv/
.pytest_cache/
backend/.docling_cache/
__pycache__/
*.py[cod]
*.egg-info/

# Geocode disk caches (regenerated on demand from Nominatim)
backend/.geocode_cache*.json

# Baseline-generation resume checkpoints. Scratch state for an in-progress metered run:
# the fixture it produces IS committed, this is only the means of surviving a crash.
backend/tests/eval/fixtures/.ckpt_*.jsonl

# Backend runtime artifacts
backend/uploads/
_upgrade_inspect/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# extraction/ingest/eval run artifacts (checkpoints, per-run JSONL, output dumps).
# All of backend/test_results/ is generated at runtime; the committed gold-set
# FIXTURES live under backend/tests/eval/fixtures/, not here, so this is safe.
backend/test_results/
/test_results/

# Harness report dumps written at the repo root (run_ablation --markdown, run_bootstrap,
# run_recall, run_baselines, run_evaluation). Every one recomputes offline from the
# committed fixtures in seconds, so a stale copy in git is worse than no copy.
/results_*.md
/results_*.txt
/results_*.json
/baselines_*.md

# NOT ignored, deliberately — do not add these:
#   backend/tests/eval/fixtures/       frozen raw extractions + Docling page caches. Every
#                                      number in the paper is computed from these; they are
#                                      what makes the results reproducible offline. This
#                                      includes baseline_*.jsonl / *.meta.json generated by
#                                      scripts/run_baselines.py --generate.
#   backend/tests/eval/worksheets/     annotation worksheets + sampling manifests. The blank
#                                      worksheet records the exact sample drawn (seeded) and
#                                      the annotated one IS the gold data.
#   backend/tests/eval/GOLD_HASHES.json  tamper-gate manifest (test_gold_integrity.py).
